# ════════════════════════════════════════════════════════════════════
# Variables de entorno de PRODUCCIÓN — copiar a .env.production
# y rellenar con valores reales. NO subir .env.production a git.
# ════════════════════════════════════════════════════════════════════

# ── Postgres (usados por docker-compose.prod.yml para construir DATABASE_URL) ──
POSTGRES_USER=domtrace
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-fuerte
POSTGRES_DB=domtrace

# DATABASE_URL y REDIS_URL los genera docker-compose.prod.yml automáticamente
# apuntando a los contenedores postgres/redis. No hace falta definirlos aquí.

# ── Auth ──────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-minimo-32-caracteres
REFRESH_SECRET=cambia-esto-por-otro-secreto-de-minimo-32-caracteres

# ── Stripe (claves LIVE si vais a cobrar de verdad) ─────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Push notifications ────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=...
FCM_SERVER_KEY=...

# ── Storage (Cloudflare R2) ───────────────────────────────────────────
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=domtrace-assets

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── IA (Stoqly assistant) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Voz (ElevenLabs) ──────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ── App / URLs públicas ──────────────────────────────────────────────
BASE_URL=https://api.stoqlyhome.com
ALBARAN_URL=https://albaran.stoqlyhome.com
NODE_ENV=production
PORT=3000

# ── Build del panel web (usado solo en build, ver docker-compose.prod.yml) ──
VITE_API_URL=https://api.stoqlyhome.com/v1
