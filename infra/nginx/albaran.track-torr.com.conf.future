# Nginx — reverse proxy para el albarán (Next.js, contenedor Docker en :3001)
# Renombrar a "albaran.track-torr.com.conf" cuando apps/web-albaran esté implementada
# y el servicio web-albaran esté descomentado en docker-compose.prod.yml
#
server {
    listen 80;
    server_name albaran.track-torr.com;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
