generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── ENUMS ────────────────────────────────────────────────────────────

enum Tier {
  FREE       // Plan Hogar — gratuito
  EXPERTO    // Plan Experto — 9,99€/mes
  PREMIUM    // Plan Premium — 19,99€/mes
  ENTERPRISE // Futuro B2B (hostelería, empresas)
  HOGAR      // Legado — no usar en nuevos registros
}

enum HouseholdType {
  HOME
  ENTERPRISE
  WAREHOUSE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TempType {
  COLD
  AMBIENT
  FROZEN
  WARM
}

enum ItemStatus {
  OK
  EXPIRING_SOON
  EXPIRED
  CONSUMED
  DISCARDED
}

enum TagType {
  NTAG213
  NTAG215
  NTAG216
  NTAG424DNA
  SLIX
  SLIX2
  DUAL_CARRIER
}

enum TagStatus {
  UNREGISTERED
  PENDING_WRITE
  ACTIVE
  REASSIGNING
  LOCKED
}

enum DestinatarioTipo {
  CONSUMER
  ENTERPRISE
  WAREHOUSE
}

enum ExpedicionEstado {
  EXPEDIDA
  EN_TRANSITO
  ENTREGADA
  INCIDENCIA
}

enum Action {
  ITEM_ADDED
  ITEM_CONSUMED
  ITEM_DISCARDED
  ITEM_MOVED
  ITEM_EXPIRED
  TAG_WRITTEN
  TAG_SCANNED
  TAG_REASSIGNED
  ALBARAN_OPENED
  ALBARAN_CONFIRMED
  INCIDENCIA_REPORTED
  EXPEDICION_CREATED
  EXPEDICION_TRANSIT
  EXPEDICION_DELIVERED
}

// ── USUARIOS Y AUTENTICACIÓN ─────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?   // null si OAuth
  resetToken            String?   // token de recuperación de contraseña (1h)
  resetTokenExpiry      DateTime?
  name                  String
  locale                String    @default("es-ES")
  subscriptionTier      Tier      @default(FREE)
  subscriptionExpiresAt DateTime?
  stripeCustomerId      String?
  pushToken             String?
  allergens             String[]  // códigos de alérgeno: GLUTEN, LACTOSA, FRUTOS_SECOS...

  // Accesibilidad
  accessibilityMode     String    @default("VOICE") // VOICE | VIBRATION | SILENT | COMBINED
  textSize              String    @default("NORMAL") // NORMAL | LARGE | XLARGE
  highContrast          Boolean   @default(false)
  reduceMotion          Boolean   @default(false)
  voiceSpeed            String    @default("NORMAL") // SLOW | NORMAL | FAST

  // Stoqly personalization
  assistantName         String    @default("Stoqly")
  humorEnabled          Boolean   @default(true)

  // Ubicación
  codigoPostal          String?   // Para localizar Banco de Alimentos y farmacias SIGRE cercanas

  // Categorías activas: ALIMENTACION, BODEGA, COSMETICOS, MEDICAMENTOS, LIMPIEZA, BEBES
  categoriasActivas     String[]  @default(["ALIMENTACION"])

  // Alergias personalizadas (además de las predefinidas)
  alergiasPersonalizadas String[] @default([])

  // Perfil nutricional y de salud
  pesoKg                Float?    // peso en kg
  alturaCm              Float?    // altura en cm
  edadAnos              Int?      // edad
  nivelActividad        String?   // SEDENTARIO | LIGERO | MODERADO | ACTIVO | MUY_ACTIVO
  objetivoNutricional   String?   // PERDER_PESO | MANTENER | GANAR_MUSCULO | DIETA_ESPECIFICA

  // Actividad física y deporte
  deporte               String?   // ej: "Running", "Crossfit", "Ciclismo", "Natación"
  deporteNivel          String?   // PRINCIPIANTE | INTERMEDIO | AVANZADO | COMPETICION
  deporteDiasSemana     Int?      // días por semana que practica

  // Hogar activo (selector multi-hogar)
  activeHouseholdId     String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  households  HouseholdMember[]

  @@map("users")
}

// ── HOGARES Y EMPRESAS ───────────────────────────────────────────────

model Household {
  id          String        @id @default(uuid())
  name        String
  ownerId     String
  type        HouseholdType @default(HOME)
  erpWebhook  String?       // URL webhook ERP para Enterprise
  supermarket String?       // supermercado preferido

  // Dirección de entrega para pedidos a supermercado
  direccionCalle     String?
  direccionPiso      String?
  direccionCodigoPostal String?
  direccionCiudad    String?
  direccionNombre    String?   // Nombre del destinatario
  direccionTelefono  String?   // Teléfono de contacto para el repartidor

  createdAt   DateTime      @default(now())

  members     HouseholdMember[]
  invites     HouseholdInvite[]
  zones       PantryZone[]
  items       Item[]
  babies      Baby[]

  @@map("households")
}

model HouseholdMember {
  householdId String
  userId      String
  role        Role
  joinedAt    DateTime @default(now())

  household   Household @relation(fields: [householdId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@id([householdId, userId])
  @@map("household_members")
}

// ── INVITACIONES AL HOGAR ────────────────────────────────────────────

model HouseholdInvite {
  id          String    @id @default(uuid())
  householdId String
  invitedBy   String
  email       String
  token       String    @unique
  role        Role      @default(MEMBER)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([email])
  @@map("household_invites")
}

// ── ZONAS DE DESPENSA ────────────────────────────────────────────────

model PantryZone {
  id            String    @id @default(uuid())
  householdId   String
  name          String
  icon          String
  temperatureType TempType
  position      Int
  createdAt     DateTime  @default(now())

  household     Household @relation(fields: [householdId], references: [id])
  items         Item[]

  @@map("pantry_zones")
}

// ── ITEMS DE INVENTARIO ──────────────────────────────────────────────

model Item {
  id          String      @id @default(uuid())
  householdId String
  zoneId      String?
  addedBy     String
  name        String
  barcode     String?     // EAN-13/EAN-8
  epc         String?     // EPC del tag si viene de albarán
  categoryId  String?
  expiryDate  DateTime?
  lotNumber   String?     // lote del fabricante (OCR de etiqueta)
  openedAt    DateTime?   // para cálculo PAO
  paoMonths   Int?        // Period After Opening
  quantity    Decimal     @default(1)
  unit        String      @default("u")
  status      ItemStatus  @default(OK)
  pendienteDonacion Boolean @default(false)  // apartado para llevar al Banco de Alimentos

  // Productos frescos sin fecha de caducidad
  fechaCompra       DateTime?  // cuándo se compró (para calcular días desde la compra)
  tipoFresco        String?    // TUBERCULO | RAIZ | HOJA | TOMATE | ALLIUM | FRUTA_CLIM | FRUTA_NO_CLIM | CITRICO | HIERBA
  vidaUtilDias      Int?       // vida útil estimada en días desde la compra
  conservacion      String?    // consejo de conservación óptima

  price       Decimal?    // precio real pagado
  allergens   String[]    // alérgenos detectados

  // Datos nutricionales (por 100g/100ml, obtenidos de OpenFoodFacts o manual)
  kcalPor100  Float?      // calorías por 100g
  protPor100  Float?      // proteínas por 100g
  carbPor100  Float?      // carbohidratos por 100g
  grasaPor100 Float?      // grasas totales por 100g
  notes       String?
  imageUrl    String?

  // Suplementos y medicamentos
  dosisDesc     String?   // ej: "1 cápsula en ayunas", "2 comprimidos con comida"
  frecuenciaToma String?  // DIARIO | CADA_8H | CADA_12H | SEMANAL | SEGUN_NECESIDAD

  // Bebés: si el item pertenece a un bebé concreto
  babyId      String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  household   Household   @relation(fields: [householdId], references: [id])
  zone        PantryZone? @relation(fields: [zoneId], references: [id])
  baby        Baby?       @relation(fields: [babyId], references: [id])
  tags        Tag[]
  movements   Movement[]

  @@index([householdId])
  @@index([expiryDate])
  @@index([zoneId])
  @@index([barcode])
  @@index([epc])
  @@map("items")
}

// ── ETIQUETAS NFC/RFID ───────────────────────────────────────────────

model Tag {
  id            String    @id // UID del chip: "04:AB:CD:..."
  epc           String?   @unique
  itemId        String?
  householdId   String?
  expedicionId  String?
  tagType       TagType
  status        TagStatus @default(UNREGISTERED)
  registeredAt  DateTime?
  lastScannedAt DateTime?
  scanCount     Int       @default(0)

  item          Item?       @relation(fields: [itemId], references: [id])
  expedicion    Expedicion? @relation(fields: [expedicionId], references: [id])
  movements     Movement[]

  @@map("tags")
}

// ── EXPEDICIONES (TrackRFID / albarán) ──────────────────────────────

model Expedicion {
  id               String           @id @default(uuid())
  epc              String           @unique
  remitenteId      String
  destinatarioTipo DestinatarioTipo
  destinatarioRef  String?          // email, CIF o código almacén
  estado           ExpedicionEstado @default(EXPEDIDA)
  productoNombre   String
  productoRef      String?
  lote             String?
  numeroPedido     String?
  centroCosto      String?
  departamento     String?
  fechaExpedicion  DateTime         @default(now())
  fechaEntrega     DateTime?
  latEntrega       Float?
  lngEntrega       Float?
  createdAt        DateTime         @default(now())

  tags             Tag[]
  movements        Movement[]

  @@index([remitenteId])
  @@index([estado])
  @@map("expediciones")
}

// ── MOVIMIENTOS (trazabilidad inmutable) ─────────────────────────────

model Movement {
  id           String      @id @default(uuid())
  itemId       String?
  expedicionId String?
  tagId        String?
  fromZoneId   String?
  toZoneId     String?
  action       Action
  performedBy  String
  metadata     Json?
  createdAt    DateTime    @default(now())

  item         Item?       @relation(fields: [itemId], references: [id])
  expedicion   Expedicion? @relation(fields: [expedicionId], references: [id])
  tag          Tag?        @relation(fields: [tagId], references: [id])

  @@index([itemId, createdAt(sort: Desc)])
  @@index([expedicionId, createdAt(sort: Desc)])
  @@map("movements")
}

// ── LOG DE CONVERSACIONES CON VICKY ─────────────────────────────────
// Registra cada interacción para detectar patrones y peticiones no cubiertas

model StoqlyLog {
  id            String   @id @default(uuid())
  householdId   String
  userId        String
  userMessage   String
  vickyReply    String?
  toolsUsed     String[] // nombres de las herramientas ejecutadas
  wasHandled    Boolean  @default(true) // false = Vicky no pudo resolver la petición
  createdAt     DateTime @default(now())

  @@index([householdId, createdAt(sort: Desc)])
  @@index([wasHandled, createdAt(sort: Desc)])
  @@map("stoqly_logs")
}

// ── BEBÉS ────────────────────────────────────────────────────────────

model Baby {
  id          String   @id @default(uuid())
  householdId String
  name        String
  birthDate   DateTime
  gender      String?  // M | F | null
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household    Household        @relation(fields: [householdId], references: [id])
  feedings     BabyFeeding[]
  measurements BabyMeasurement[]
  items        Item[]

  @@index([householdId])
  @@map("babies")
}

model BabyFeeding {
  id        String   @id @default(uuid())
  babyId    String
  type      String   // PECHO_IZQUIERDO | PECHO_DERECHO | BIBERON | SOLIDOS
  amountMl  Float?   // ml (biberón)
  amountG   Float?   // gramos (sólidos)
  durationMin Int?   // minutos (pecho)
  notes     String?
  feedingAt DateTime @default(now())
  createdAt DateTime @default(now())

  baby      Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId, feedingAt(sort: Desc)])
  @@map("baby_feedings")
}

model BabyMeasurement {
  id          String   @id @default(uuid())
  babyId      String
  weight      Float?   // kg
  height      Float?   // cm
  headCirc    Float?   // cm — perímetro cefálico
  measuredAt  DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  baby        Baby     @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([babyId, measuredAt(sort: Desc)])
  @@map("baby_measurements")
}

// ── LISTA DE LA COMPRA ───────────────────────────────────────────────

model ShoppingItem {
  id          String   @id @default(uuid())
  householdId String
  name        String
  quantity    Decimal  @default(1)
  unit        String   @default("u")
  supermarket String?
  addedBy     String   // "stoqly" | userId
  checked     Boolean  @default(false)
  createdAt   DateTime @default